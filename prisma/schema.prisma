generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  favorites  UserFavorite[]
  trackPlays UserTrackPlay[]
  playlists        Playlist[]
  podcastFollows   PodcastFollow[]
  podcastSaves     PodcastEpisodeSave[]
  podcastPlaybacks PodcastPlayback[]
}

model Track {
  id         String   @id @default(cuid())
  title      String
  artist     String
  album      String
  duration   Int // seconds
  genre      String
  coverColor String
  playCount  Int      @default(0)
  createdAt  DateTime @default(now())
  audioUrl   String?
  webpageUrl String?

  playlistTracks PlaylistTrack[]
  favorites      UserFavorite[]
  trackPlays     UserTrackPlay[]

  @@index([genre])
  @@index([artist])
  @@index([createdAt])
}

model UserFavorite {
  userId  String
  trackId String
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId])
}

model UserTrackPlay {
  userId       String
  trackId      String
  lastPlayedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId, lastPlayedAt])
}

model Playlist {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  coverColor  String
  userId      String?
  createdAt   DateTime @default(now())

  user   User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@index([userId])
}

model PodcastFollow {
  userId    String
  showId    String
  showTitle String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, showId])
  @@index([userId, createdAt])
}

model PodcastEpisodeSave {
  userId       String
  episodeId    String
  showId       String
  title        String
  imageUrl     String?
  webpageUrl   String?
  savedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([userId, savedAt])
}

model PodcastPlayback {
  userId       String
  episodeId    String
  showId       String
  title        String
  imageUrl     String?
  webpageUrl   String?
  duration     Int      @default(0)
  position     Int      @default(0)
  completed    Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([userId, updatedAt])
}

model PlaylistTrack {
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@index([playlistId, position])
}
